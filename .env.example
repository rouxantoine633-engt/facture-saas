# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/facture_saas?schema=public"

# Auth.js
AUTH_SECRET="genere-avec: openssl rand -base64 33"
AUTH_URL="http://localhost:3000"

# OAuth Google (optionnel)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email transactionnel (Brevo)
BREVO_API_KEY=""
EMAIL_FROM="contact@example.com"

# Stockage fichiers (Cloudflare R2 / S3-compatible)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Cron (protection de la route de relances automatiques)
CRON_SECRET="genere-un-secret-aleatoire"

# Stripe (abonnement 39€/mois) — utilise tes clés de TEST (pk_test_/sk_test_)
# en développement ; les clés live ne doivent être saisies qu'en production,
# jamais collées dans un chat ou un outil tiers.
STRIPE_SECRET_KEY=""
# Secret de signature de l'endpoint webhook (dashboard Stripe > Webhooks, ou
# affiché par `stripe listen` en local) — jamais le même que STRIPE_SECRET_KEY.
STRIPE_WEBHOOK_SECRET=""
